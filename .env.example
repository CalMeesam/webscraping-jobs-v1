APP_NAME="Adaptive Career Job Extraction Engine"
DEBUG=false
MAX_DISCOVERY_DEPTH=3
MAX_VISITED_URLS=20
MAX_CANDIDATE_URLS=10
CONFIDENCE_THRESHOLD=0.6
HTTP_TIMEOUT_SECONDS=15.0
MAX_REDIRECTS=10
DEFAULT_CONCURRENCY=5
PLAYWRIGHT_TIMEOUT_MS=10000
PLAYWRIGHT_HEADLESS=true

# Database Persistence Configuration (SQLite fallback if unset)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/extraction_jobs_db

# LLM Refinement Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
MAX_LLM_REFINE_JOBS=5
LLM_TIMEOUT_SECONDS=3.0
